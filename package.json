{
  "name": "dat-freight-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "build-notypecheck": "vite build",
    "lint": "eslint .",
    "lint-fix": "eslint . --fix",
    "test": "vitest",
    "test-run": "vitest run",
    "test-related": "vitest related --run --passWithNoTests",
    "test-coverage": "vitest run --coverage",
    "preview": "vite preview",
    "prepare": "husky install",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": [
      "eslint --fix --no-warn-ignored",
      "npm run test-related --"
    ]
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/public-sans": "^5.3.0",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@mui/x-charts": "^9.13.0",
    "@tanstack/react-router": "^1.170.32",
    "ag-grid-community": "^36.1.0",
    "ag-grid-react": "^36.1.0",
    "maplibre-gl": "^6.9.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/tanstack-react": "^10.6.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tanstack/react-query": "latest",
    "@tanstack/router-plugin": "^1.168.35",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.9.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-dom": "^5.18.7",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "eslint-plugin-react-x": "^5.18.7",
    "eslint-plugin-storybook": "^10.6.0",
    "globals": "^17.11.0",
    "husky": "^8.0.0",
    "lint-staged": "^17.4.1",
    "storybook": "^10.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
